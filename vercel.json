{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/patrol", "destination": "/patrol.html" },
    { "source": "/patrc", "destination": "/patrol.html" },
    { "source": "/dev-portal", "destination": "/dev-portal.html" },
    { "source": "/dev", "destination": "/dev-portal.html" },
    { "source": "/clients", "destination": "/clients.html" },
    { "source": "/client", "destination": "/clients.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/app", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/dev-portal.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }]
    },
    {
      "source": "/dev-portal",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }]
    },
    {
      "source": "/dev",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }]
    },
    {
      "source": "/clients.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/patrol.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    }
  ],
  "cleanUrls": true
}
